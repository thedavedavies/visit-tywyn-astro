---
import Icon from '../Icon/Icon.astro';
import { eventsByMonth } from '../../lib/events';
import styles from './EventsCalendar.module.scss';

interface Props {
	/** Accessible label for the calendar region. */
	label?: string;
	sectionId?: string;
	tag?: string;
}

const {
	label = 'Tywyn and Aberdyfi events calendar',
	sectionId = 'vt-events-calendar',
	tag,
} = Astro.props;

const months = eventsByMonth(new Date(), tag);
---

{
	months.length > 0 && (
		<section class={styles.calendar} aria-label={label}>
			{months.map((month) => (
				<section class={styles.month} aria-labelledby={`${sectionId}-${month.key}`}>
					<h2 id={`${sectionId}-${month.key}`} class={styles.monthHeading}>
						{month.label}
					</h2>
					<ul class={styles.events}>
						{month.events.map((event) => {
							// A month-only event that stays inside one month has no
							// date to show (the month heading already conveys it); a
							// month-spanning one ("May to September") still does.
							const isMultiMonth = event.startIso.slice(0, 7) !== event.endIso.slice(0, 7);
							const showDate = !event.monthOnly || isMultiMonth;
							const eventPage = event.internalPath?.startsWith('/events/')
								? event.internalPath
								: null;
							const venuePage = event.internalPath && !eventPage ? event.internalPath : null;
							const venueSuffix = event.locality ? `, ${event.locality}` : '';
							const venueName =
								venueSuffix && event.location.endsWith(venueSuffix)
									? event.location.slice(0, -venueSuffix.length)
									: event.location;
							const detailsUrl = eventPage ?? event.externalUrl;
							const detailsLabel = eventPage ? 'Find out more' : event.externalLabel;
							return (
								<li class:list={[styles.event, { [styles.eventPast]: event.isPast }]}>
									<div class={styles.when}>
										{showDate && (
											<time datetime={event.startIso} class={styles.date}>
												<Icon name="calendar" />
												{event.dateLabel}
											</time>
										)}
									</div>
									<div class={styles.what}>
										<h3 class={styles.title}>{event.title}</h3>
										{event.location && (
											<p class={styles.location}>
												<Icon name="marker" />
												{event.location}
											</p>
										)}
										{event.summary && <p class={styles.summary}>{event.summary}</p>}
										{event.isPast && <p class={styles.finished}>Event finished</p>}
										{(detailsUrl || venuePage) && (
											<p class={styles.actions}>
												{detailsUrl && (
													<a
														class={styles.moreLink}
														href={detailsUrl}
														aria-label={
															eventPage
																? `Find out more about ${event.title}`
																: `${detailsLabel} for ${event.title} (opens in new tab)`
														}
														{...(eventPage ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
													>
														{detailsLabel}
														<span aria-hidden="true" class={styles.moreArrow}>
															→
														</span>
													</a>
												)}
												{venuePage && (
													<a class={styles.venueLink} href={venuePage}>
														About {venueName || 'the venue'}
													</a>
												)}
											</p>
										)}
									</div>
								</li>
							);
						})}
					</ul>
				</section>
			))}
		</section>
	)
}
