---
import PageLayout from '../layouts/PageLayout.astro';
import EntryHeader from '../components/EntryHeader/EntryHeader.astro';
import TideChart from '../components/TideChart/TideChart.astro';
import { getTidesSnapshot, getWeatherSnapshot, type TideEvent } from '../lib/conditions';
import { webPage } from '../lib/jsonld';

const snap = getTidesSnapshot();
const chartSnap = getTidesSnapshot(new Date(), { includePast: true });
const sunDays = getWeatherSnapshot()?.daily ?? [];

const TZ = 'Europe/London';
const DAY_KEY_FMT = new Intl.DateTimeFormat('en-CA', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: TZ,
});
const DAY_LABEL_FMT = new Intl.DateTimeFormat('en-GB', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	timeZone: TZ,
});
const TIME_FMT = new Intl.DateTimeFormat('en-GB', {
	hour: 'numeric',
	minute: '2-digit',
	hour12: true,
	timeZone: TZ,
});

interface TideDay {
	key: string;
	label: string;
	events: TideEvent[];
}

const days: TideDay[] = [];
for (const event of snap?.upcoming ?? []) {
	const when = new Date(event.timeIso);
	const key = DAY_KEY_FMT.format(when);
	const last = days.at(-1);
	if (last && last.key === key) {
		last.events.push(event);
	} else {
		days.push({ key, label: DAY_LABEL_FMT.format(when), events: [event] });
	}
}

const next = snap?.upcoming[0];

const ranges = days.map((day) => {
	const highs = day.events.filter((e) => e.type === 'high').map((e) => e.heightM);
	const lows = day.events.filter((e) => e.type === 'low').map((e) => e.heightM);
	return highs.length && lows.length ? Math.max(...highs) - Math.min(...lows) : 0;
});
const biggestDay = ranges.length ? days[ranges.indexOf(Math.max(...ranges))] : undefined;

const title = 'Tywyn tide times';
const description =
	'High and low tide times and heights for Tywyn beach for the week ahead, from UK Hydrographic Office predictions for the Aberdyfi station, refreshed every few hours.';

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Tide times' }];

const jsonLd = webPage({
	title,
	description,
	url: Astro.url,
});
---

<PageLayout
	title={title}
	description={description}
	breadcrumbs={breadcrumbs}
	jsonLd={jsonLd}
	sidebarProps={{ showTides: false }}
>
	<EntryHeader
		title="Tywyn tide times"
		subtitle="High and low water for the week ahead at Tywyn beach"
	/>

	<div class="entry-content">
		{
			!snap || !next ? (
				<p>Tide predictions are being refreshed. Check back in a few minutes.</p>
			) : (
				<>
					<p class="next" aria-label="Next tide">
						Next tide: <strong>{next.type === 'high' ? 'high water' : 'low water'}</strong> at{' '}
						<strong>{TIME_FMT.format(new Date(next.timeIso))}</strong> on{' '}
						{DAY_LABEL_FMT.format(new Date(next.timeIso))} ({next.heightM.toFixed(1)}m)
						{snap.stale && <em> &middot; last good reading</em>}
					</p>

					{chartSnap && <TideChart events={chartSnap.upcoming} days={sunDays} />}

					<section aria-labelledby="week-heading">
						<h2 id="week-heading">This week's tides</h2>
						{biggestDay && (
							<p class="rangeNote">
								The biggest tides of the week fall on {biggestDay.label}, with about{' '}
								{Math.max(...ranges).toFixed(1)}m between high and low water.
							</p>
						)}
						<table class="tides">
							<caption class="sr-only">
								High and low water times and heights for the week ahead
							</caption>
							<thead>
								<tr>
									<th scope="col">Day</th>
									<th scope="col">Tide</th>
									<th scope="col">Time</th>
									<th scope="col" class="num">
										Height
									</th>
								</tr>
							</thead>
							{days.map((day) => (
								<tbody>
									{day.events.map((event, i) => (
										<tr>
											{i === 0 && (
												<th scope="rowgroup" rowspan={day.events.length}>
													{day.label}
												</th>
											)}
											<td class:list={[event.type === 'high' ? 'high' : 'low']}>
												{event.type === 'high' ? 'High' : 'Low'}
											</td>
											<td>{TIME_FMT.format(new Date(event.timeIso))}</td>
											<td class="num">{event.heightM.toFixed(1)}m</td>
										</tr>
									))}
								</tbody>
							))}
						</table>
					</section>
				</>
			)
		}

		<h2>About the tides at Tywyn</h2>
		<p>
			These are UK Hydrographic Office predictions for the Aberdyfi station (0486), the nearest
			standard measuring point to Tywyn beach; actual times along the beach differ by only a few
			minutes. The tide here typically rises and falls between three and five metres, with the
			biggest ranges on spring tides around the full and new moon. Low water uncovers a wide, flat
			stretch of sand that makes for the best beach walks and rock pooling.
		</p>

		<h2>Staying safe</h2>
		<p>
			The flood tide comes in quickly over the flat sand, and currents run hard near the Dysynni and
			Dyfi river mouths. Check the times above before a long walk towards Aberdyfi, keep off
			sandbanks on a rising tide, and if you're swimming, stay between the flags when the beach is
			patrolled in summer.
		</p>

		<h2>Make a day of it</h2>
		<p>
			Check the <a href="/weather/">Tywyn weather forecast</a> alongside the tides, see the beach right
			now on the <a href="/webcam/">live seafront webcam</a>, or browse
			<a href="/things-to-do/tywyn-beach/">our guide to Tywyn beach</a>.
		</p>

		<p class="provenance">
			Tidal predictions from the UK Hydrographic Office via <a
				href="https://easytide.admiralty.co.uk/"
				target="_blank"
				rel="noopener noreferrer nofollow"
				>Admiralty EasyTide<span class="sr-only"> (opens in new tab)</span></a
			>, refreshed roughly every three hours.
		</p>
	</div>
</PageLayout>

<style lang="scss">
	@use '../styles/abstracts/variables' as *;

	.next {
		margin: $space-5 0;
		padding: $space-3 $space-4;
		border-left: 4px solid $color-data;
		background: $color-bg-alt;
		border-radius: 0 $radius-sm $radius-sm 0;
		font-size: 1.05rem;

		em {
			font-size: 0.85rem;
			color: $color-text-dim;
		}
	}

	.rangeNote {
		font-size: 0.95rem;
		color: $color-text-muted;
	}

	.tides {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;

		th,
		td {
			padding: $space-2 $space-3;
			text-align: left;
			border-bottom: 1px solid $color-border;
			vertical-align: top;
		}

		thead th {
			font-size: 0.8rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: $color-text-muted;
		}

		tbody th {
			font-weight: 700;
			white-space: nowrap;
		}

		.high {
			color: $color-primary;
			font-weight: 700;
		}

		.low {
			color: $color-text-muted;
		}

		.num {
			text-align: right;
			font-variant-numeric: tabular-nums;
		}
	}

	.provenance {
		font-size: 0.85rem;
		color: $color-text-dim;
	}
</style>
