{
	"name": "visit-tywyn-astro",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"test": "npm run build && npm run check:links -- --no-dev",
		"test:a11y": "astro build && tsx tools/a11y-scan.ts",
		"refresh:conditions": "tsx tools/refresh-conditions.ts",
		"check:links": "tsx tools/check-links.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"perf:pages": "tsx tools/perf/measure-pages.ts",
		"perf:seo": "tsx tools/perf/seo-compare.ts"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.8",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.4.10"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@joplin/turndown-plugin-gfm": "^1.0.68",
		"@mixmark-io/domino": "^2.2.0",
		"@types/node": "^26.6.6",
		"axe-core": "^4.14.0",
		"prettier": "^3.10.0",
		"prettier-plugin-astro": "1.1.2",
		"puppeteer": "^25.17.0",
		"sass": "^1.108.2",
		"tsx": "^4.23.15",
		"turndown": "^7.2.5",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"puppeteer": true,
		"esbuild": false,
		"@parcel/watcher": false,
		"fsevents": false
	}
}
