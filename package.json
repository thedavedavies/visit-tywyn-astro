{
	"name": "visit-tywyn-astro",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"test": "npm run build && npm run check:links -- --no-dev",
		"test:a11y": "astro build && tsx tools/a11y-scan.ts",
		"refresh:conditions": "tsx tools/refresh-conditions.ts",
		"check:links": "tsx tools/check-links.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"perf:pages": "tsx tools/perf/measure-pages.ts",
		"perf:seo": "tsx tools/perf/seo-compare.ts"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.3.5",
		"@astrojs/sitemap": "^3.7.2",
		"astro": "^7.2.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@types/node": "^26.2.0",
		"axe-core": "^4.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"puppeteer": "^25.8.0",
		"sass": "^1.99.0",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3"
	}
}
